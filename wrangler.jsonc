{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "miharu",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-19",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "miharu-status",
      "database_id": "ec29a528-708c-4ce3-8a35-f9416dacf499",
      "migrations_dir": "db/migrations",
    },
  ],
  "triggers": {
    "crons": ["* * * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "env": {
    "preview": {
      "name": "miharu-preview",
      "assets": {
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "miharu-status-preview",
          "database_id": "fe57c26a-0fac-40f1-b083-7167cd2c19f4",
          "migrations_dir": "db/migrations",
        },
      ],
      "triggers": {
        "crons": [],
      },
    },
  },
}

{
  "name": "miharu",
  "version": "0.1.0",
  "private": true,
  "description": "外部サービスの公式ステータスを集約するダッシュボード",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "cf dev",
    "build": "pnpm typecheck && cf build",
    "deploy": "cf deploy --prebuilt",
    "cf-typegen": "cf workers types",
    "db:migrate:local": "cf d1 migrations apply ec29a528-708c-4ce3-8a35-f9416dacf499 --dir db/migrations --local --persist-to .cloudflare/state",
    "db:migrate:remote": "cf d1 migrations apply ec29a528-708c-4ce3-8a35-f9416dacf499 --dir db/migrations",
    "db:migrate:preview": "cf d1 migrations apply fe57c26a-0fac-40f1-b083-7167cd2c19f4 --dir db/migrations",
    "preview:deploy": "cf previews deploy",
    "lint": "oxlint . && oxfmt --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "pnpm cf-typegen && tsc --noEmit"
  },
  "dependencies": {
    "hono": "4.13.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simple-icons": "^16.30.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.0",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "autoprefixer": "^10.6.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "cf": "1.0.0-beta.20",
    "jsdom": "^27.0.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "postcss": "^8.5.30",
    "tailwindcss": "3.4.17",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": "^26.12.1"
  },
  "packageManager": "pnpm@11.5.1"
}

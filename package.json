{
  "name": "miharu",
  "version": "0.1.0",
  "private": true,
  "description": "外部サービスの公式ステータスを集約するダッシュボード",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "vite dev",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply miharu-status --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply miharu-status --remote",
    "db:migrate:preview": "wrangler d1 migrations apply miharu-status-preview --remote --config wrangler.preview-migrations.jsonc",
    "preview:deploy": "pnpm build && wrangler preview",
    "lint": "oxlint . && oxfmt --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "pnpm typegen && tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.3",
    "drizzle-orm": "0.45.4",
    "fast-xml-parser": "^5.11.2",
    "hono": "4.13.13",
    "html-to-text": "^10.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simple-icons": "^16.30.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "autoprefixer": "^10.6.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^27.0.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.80.0",
    "postcss": "^8.5.30",
    "tailwindcss": "3.4.19",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "wrangler": "4.151.1"
  },
  "engines": {
    "node": "^26.12.1"
  },
  "packageManager": "pnpm@11.28.6"
}

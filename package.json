{
  "name": "miharu",
  "version": "0.1.0",
  "private": true,
  "description": "外部サービスの公式ステータスを集約するダッシュボード",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply miharu-status --local",
    "db:migrate:remote": "wrangler d1 migrations apply miharu-status --remote",
    "lint": "oxlint . && oxfmt --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "4.13.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simple-icons": "^16.30.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@rolldown/plugin-babel": "^0.2.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^27.0.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "wrangler": "4.151.0"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "packageManager": "pnpm@11.5.1"
}

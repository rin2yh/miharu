{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": [
    ".cloudflare/types/index.d.ts",
    "src",
    "e2e",
    "playwright.config.ts",
    "vite.config.mts",
    "vitest.config.ts"
  ]
}
